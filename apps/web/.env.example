# GA4 Measurement ID — public, non-sensitive identifier.
# The production value is committed in .env.production.
# Set here to override during local development, or leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Reddit Pixel ID (e.g. "a2_xxxxxxxxxxxx") — public, non-sensitive identifier.
# Used for Reddit ad conversion tracking and retargeting. Leave blank to
# disable Reddit ads tracking entirely (pixel module becomes a no-op).
VITE_REDDIT_PIXEL_ID=

# Canonical public origin used when generating shareable URLs (UTM tags,
# QR codes, short links) from the admin panel. The admin panel is reached
# via Tailscale, so window.location.origin is wrong for these surfaces.
# Leave blank to use the production default of https://price.games. Set
# this for preview/sandbox environments that need their own public origin.
VITE_PUBLIC_SITE_URL=

# Google AdSense — master kill switch. Independent of whether the vars
# below are set: leave "false" (or blank) to keep every AdSlot mount
# point inert (renders nothing, loads no script) even after credentials
# exist below. Set to the literal string "true" to allow ads to render
# once credentials are also configured. There is no AdSense account yet,
# so leave this false until the account is created and approved.
VITE_ADS_ENABLED=false

# AdSense publisher ID (e.g. "ca-pub-xxxxxxxxxxxxxxxx"), from the AdSense
# dashboard once the account is approved. Leave blank until then.
VITE_ADSENSE_CLIENT_ID=

# Per-slot AdSense ad-unit IDs, one per ad unit created in the AdSense
# dashboard (Ads > By ad unit > + New ad unit) after the account is
# approved. Each price.games ad placement needs its own ad unit here.
# Leave blank until the corresponding ad unit exists — AdSlot renders
# nothing for a slot whose ID is unset, regardless of VITE_ADS_ENABLED.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_RESULT=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_ANCHOR=
